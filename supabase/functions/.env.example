# Segredos da Edge Function "clinicas-proximas".
# Copie para supabase/functions/.env (que o Git ignora), preencha e envie com:
#   supabase secrets set --env-file supabase/functions/.env --project-ref pyoqiecupxhdzigjudyd
# Nunca coloque estes valores no site, no Git ou em mensagens.
# As chaves do próprio Supabase (SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS e as antigas SUPABASE_ANON_KEY e
# SUPABASE_SERVICE_ROLE_KEY) o Supabase põe sozinho em toda Edge Function: não coloque aqui.

# Opcional. Chave do Google Maps Platform restrita a Places API (New) e Geocoding API.
# Sem ela, a busca usa OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Sites que podem chamar a função, separados por vírgula.
ALLOWED_ORIGINS=https://drrafaelpereirabarreto-code.github.io

# E-mail de contato enviado no User-Agent aos serviços do OpenStreetMap.
NOMINATIM_CONTACT=contato@imed.com.br
