{
  "name": "minerador-anuncios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minerador de Anúncios: coleta anúncios ativos da Biblioteca de Anúncios do Meta, calcula a Pontuação de Escala e mostra os vencedores num painel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "coletar": "tsx scripts/coletar.ts",
    "exemplo": "tsx scripts/exemplo.ts",
    "exemplo:apagar": "tsx scripts/exemplo.ts --apagar",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
