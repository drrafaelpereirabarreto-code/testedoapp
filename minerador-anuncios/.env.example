# ===========================================================
#  Minerador de Anúncios — configurações e chaves
#  Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.
# ===========================================================

# --- Acesso ao painel -----------------------------------------
# Senha para entrar no site (só você e quem você passar a senha).
SENHA_ACESSO=troque-esta-senha
# Texto longo e aleatório usado para assinar o login (qualquer coisa com 32+ letras).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# --- Coleta: Apify (opção principal) ---------------------------
# Token em https://console.apify.com/settings/integrations  ("Personal API token")
APIFY_TOKEN=
# Robô (actor) usado na coleta. O padrão é o mais usado da loja do Apify.
APIFY_ACTOR=curious_coder/facebook-ads-library-scraper
# Máximo de anúncios por busca (palavra-chave x país). Controla o custo.
APIFY_LIMITE_POR_BUSCA=50

# --- Coleta: API oficial do Meta (opcional) --------------------
# Fora da União Europeia ela só traz anúncios políticos completos.
# Deixe vazio para não usar. Token em https://developers.facebook.com/tools/explorer/
META_TOKEN=

# --- Análise com IA (Claude, da Anthropic) ---------------------
# Chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo do Claude. Padrão: claude-opus-5-5 (melhor qualidade).
# Para gastar ~40x menos, troque por: claude-haiku-5-5
CLAUDE_MODELO=claude-opus-5-5
# Quantos anúncios novos a IA analisa por dia (os de maior pontuação primeiro).
IA_MAX_POR_DIA=30

# --- Banco de dados --------------------------------------------
# Vazio = SQLite num arquivo (dados/minerador.db) — ideal para rodar no seu computador.
# Na Vercel use Postgres (Supabase, Neon...): cole aqui a "connection string" postgres://...
DATABASE_URL=

# --- Agendamento ------------------------------------------------
# A Vercel manda este segredo quando chama a coleta diária (/api/cron). Invente um texto longo.
CRON_SECRET=
# Fuso horário usado para "hoje".
FUSO_HORARIO=America/Sao_Paulo
